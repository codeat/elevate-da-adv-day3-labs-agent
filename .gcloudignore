# Files excluded from the source upload that Agent Runtime / Cloud Build sees.
#
# Without this file the uploader falls back to .gitignore, which does NOT cover
# evaluation artifacts or the agents-cli state directory - both are large, both
# are useless to the build, and traces can carry customer-shaped data.
.git/
.gitignore
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Evaluation traces and grade results (regenerated by `make eval`).
artifacts/

# agents-cli local state (recorded deploy operations, cached server pids).
.google-agents-cli/

# Local-only secrets and backups. Real config is injected via
# `agents-cli deploy --update-env-vars`.
*.bak
app/.env.bak

# Terraform state from the Day-2 infrastructure lab.
deploy/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
