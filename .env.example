# ---------------------------------------------------------------------------
# Cymbal Retail Operations Coordinator Agent - environment template
# Copy to `app/.env` (git-ignored) and fill in your own values.
#   cp .env.example app/.env
# NOTHING in this project hardcodes these values; the agent fails fast if the
# mandatory ones are missing.
# ---------------------------------------------------------------------------

# --- MANDATORY -------------------------------------------------------------
# Target GCP project. Also accepted: GOOGLE_CLOUD_PROJECT / GCP_PROJECT.
PROJECT_ID=your-gcp-project-id
# Cloud Run MCP Toolbox base URL emitted by `make mcp-deploy`.
BIGTABLE_MCP_URL=https://mcp-toolbox-bigtable-<hash>-<region>.run.app

# --- REGIONAL --------------------------------------------------------------
# Conversational Data Agent API location (usually `global`).
LOCATION=global
# Compute/serving region for Cloud Run + Vertex AI Agent Runtime.
REGION=us-central1

# --- MODEL -----------------------------------------------------------------
MODEL_NAME=gemini-3.6-flash

# --- BACKENDS --------------------------------------------------------------
DATA_AGENT_ID=cymbal-retail-analytics-agent
BIGTABLE_INSTANCE=operations-db
RAG_DATASET_ID=cymbal_gold
RAG_TABLE_ID=pos_manual_chunk_embeddings
RAG_EMBEDDING_ENDPOINT=text-embedding-005

# --- GUARDRAILS ------------------------------------------------------------
# Certified retrieval confidence gate for the POS runbook RAG tool.
RAG_SIMILARITY_THRESHOLD=0.70
# Hard BigQuery cost ceiling in bytes (default 1 GiB).
BQ_MAX_BYTES_BILLED=1073741824
# Transient-fault retry budget for outbound backend calls.
TOOL_MAX_RETRIES=3

# --- ADK -------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
